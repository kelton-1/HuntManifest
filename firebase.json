{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "hosting": {
        "public": "out",
        "cleanUrls": true,
        "trailingSlash": false,
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/inventory/add",
                "destination": "/inventory/add.html"
            },
            {
                "source": "/inventory/search",
                "destination": "/inventory/search.html"
            },
            {
                "source": "/inventory/summary",
                "destination": "/inventory/summary.html"
            },
            {
                "source": "/inventory/edit/*",
                "destination": "/inventory/edit/_placeholder.html"
            },
            {
                "source": "/inventory/*",
                "destination": "/inventory/_placeholder.html"
            },
            {
                "source": "/log/new",
                "destination": "/log/new.html"
            },
            {
                "source": "/log/*",
                "destination": "/log/_placeholder.html"
            },
            {
                "source": "/plan/new",
                "destination": "/plan/new.html"
            },
            {
                "source": "/plan/*",
                "destination": "/plan/_placeholder.html"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
